{
    "layer": "top",
    "position": "top",
    "output": "HDMI-A-1",
    "height": 35,
    "spacing": 4,

    "modules-left": ["cpu", "memory", "custom/gpu", "disk", "temperature"],
	"modules-center": ["clock"],
	"modules-right": ["hyprland/workspaces"],
	
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": ""
        }
    },

    "clock": {
        "format": "󰥔  {:%H:%M   󰃭  %d/%m/%Y}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "format": "󰻠  {usage}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "󰍛  {used:0.1f}G",
        "interval": 2
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/gpu.sh",
        "interval": 2,
        "format": "{}"
    },

    "disk": {
        "format": "󰋊  {percentage_used}%",
        "path": "/",
        "interval": 30
    },

    "temperature": {
        "format": "󰔏  {temperatureC}°C",
        "critical-threshold": 80,
        "format-critical": "󰸁  {temperatureC}°C"
    }
}
